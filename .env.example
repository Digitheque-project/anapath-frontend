# Passerelle du CHU : le backend Anapath est joint par elle (routes /anapath/api).
NEXT_PUBLIC_GATEWAY_URL=
# Page de connexion centrale (ex. https://authentification-front-psi.vercel.app/login).
NEXT_PUBLIC_LOGIN_URL=
# Facultatif : WebSocket temps réel du backend Anapath.
NEXT_PUBLIC_WS_URL=
# Facultatif : domaine public pour les redirections si l'hôte reçu est interne.
APP_BASE_URL=
# Facultatif : le service est reconnu par son nom (« Anapath ») dans le jeton.
AUTH_ANAPATH_SERVICE_ID=
